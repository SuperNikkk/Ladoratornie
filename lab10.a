def catalan_dp(n: int) -> list[int]:
    """Возвращает список чисел Каталана от C(0) до C(n) с помощью ДП."""
    if n < 0:
        raise ValueError("n должно быть неотрицательным")

    dp = [0] * (n + 1)
    dp[0] = 1
    if n >= 1:
        dp[1] = 1

    for i in range(2, n + 1):
        for j in range(i):
            dp[i] += dp[j] * dp[i - j - 1]

    return dp

# Пример вывода
print(catalan_dp(5))  # [1, 1, 2, 5, 14, 42]
